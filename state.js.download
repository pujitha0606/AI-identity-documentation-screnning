      docNumber: "FR-99120488",
      country: "France",
      status: "VERIFIED",
      riskScore: 9,
      analyst: "K. Lindqvist (AG-8819)",
      presetRef: "clean_passport"
    }
  ],

  init() {
    const saved = localStorage.getItem("aegis_screening_history");
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        if (Array.isArray(parsed) && parsed.length > 0) {
          this.history = parsed;
        }
      } catch (e) {
        console.warn("Could not load history from localStorage:", e);
      }
    }
    const session = localStorage.getItem("aegis_session_user");
    if (session) {
      try {
        const u = JSON.parse(session);
        if (u.loggedIn) {
          this.currentUser = u;
          this.activeView = "dashboard";
        }
      } catch (e) {
        console.warn("Could not load session:", e);
      }
    }
    // Set default result to clean passport for initial inspection
    this.activeResult = {
      ...DEMO_PRESETS.clean_passport,
      screeningId: "SCR-2026-9812",
      scanTime: "2026-10-08 19:42:10"
    };
  },

  saveHistory() {
    try {
      localStorage.setItem("aegis_screening_history", JSON.stringify(this.history));
    } catch (e) {
      console.warn("Could not save history to localStorage:", e);
    }
  },

  addScreeningRecord(record) {
    this.history.unshift(record);
    this.saveHistory();
  },

  getStats() {
    const total = this.history.length;
    const verified = this.history.filter(h => h.status === "VERIFIED").length;
    const suspicious = this.history.filter(h => h.status === "SUSPICIOUS").length;
    const rejected = this.history.filter(h => h.status === "REJECTED").length;
    const avgRisk = total > 0 ? Math.round(this.history.reduce((acc, h) => acc + h.riskScore, 0) / total) : 0;
    return { total, verified, suspicious, rejected, avgRisk };
  }
};
